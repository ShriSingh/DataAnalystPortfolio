/* 
Note:
- Commands must be written in this order: SELECT then FROM
- Command names are case insensitive, column & tables names should be capitalized as is
*/
SELECT *
FROM job_postings_fact;

SELECT
	job_title_short,
    job_location
FROM job_postings_fact;

/*
Note:
- Can use alias for table and column names
    - Can be done using 'AS' command or by writing an alias after a space
    - Makes column & table names more readable
- Use LIMIT to skim large databases and have faster quering performance
- Is the last command of a query
*/
SELECT 
	job_posts.job_title_short,
    job_posts.job_title,
    job_posts.job_location,
    job_posts.job_via,
    job_posts.job_schedule_type,
    job_posts.job_work_from_home
FROM job_postings_fact job_posts
LIMIT 5;

SELECT 
	job_posts.job_title_short AS 'Job Title',
    job_posts.job_location AS Location,
    job_posts.job_via AS 'Online Platform',
    job_posts.salary_year_avg AS Salary
FROM job_postings_fact job_posts;

/*
DISTINCT gets unique rows
- Takes a lot of processing power
- Used within SQL functions
- Comes right after 'SELECT' command
*/
SELECT DISTINCT
    job_posts.job_title_short
FROM job_postings_fact job_posts;

/*
WHERE sets a condition for the query
- Filters out the query
    - Can filter categorical(text) or numerical data
- Comes after 'FROM' command
*/
SELECT
	job_title_short,
    job_location,
    job_via,
    salary_year_avg
FROM job_postings_fact
WHERE job_title_short = 'Data Analyst';

SELECT
	job_title_short,
    job_location,
    job_via,
    salary_year_avg
FROM job_postings_fact
WHERE salary_year_avg > 90000;

/*
'--' Single line comments are for documenting and debugging
- Lines marked with '--' are ignored during execution

'/* */' Multi-line comments are for providing more robust description
*/

/*
ORDER BY is used for sorting the rows
- Comes right after WHERE command
- Default sorting order is ascending(smallest -> largest, A -> Z)
- NULL is the smallest is no values are given
*/
SELECT
	job_title_short,
    job_location,
    job_via,
    salary_year_avg
FROM job_postings_fact
WHERE job_title_short = 'Data Analyst'
ORDER BY salary_year_avg DESC;

/*
Order to Write Commands:
1. SELECT column1, column2,...
2. FROM table_name
3. WHERE condition
4. GROUP BY column
5. HAVING colution
6. ORDER BY column1 [ASC|DESC] ...
7. LIMIT number
*/

/*
Full Order of Execution:
1. FROM/JOIN
    - Specifies the tables to retrieve data from and how to join them
2. WHERE
    - Filters rows based on conditions
3. GROUP BY
    - Group rows share a property so aggregate functions can be applied
4. HAVING
    - Filters groups based on aggregate conditions
    - Used after GROUP BY
5. SELECT
    - Select specific columns to display in the final result
6. DISTINCT
    - Removes duplicate rows from the result set
    - Applied after SELECT
7. ORDER BY
    - Sorts the result set based on specified columns/values
8. LIMIT/OFFSET
    - Limits the number of rows returned
    - Often used for pagination

This sequence ensures SQL queries are processed efficiently and logically
- This flow reflects the logical processing order necessary to construct 
the final dataset and optimization principles databases use to execute
queries efficiently
*/

/*
Processing when query is run:
1. Query is first taken by the Data Access Logic and sent to the Parser
2. Parser goes through the query statements and sends it to the Optimizer
for processing
3. Optimizer then looks through the Execution Plan Cache to check if the query
had already been run, so it would take less time for Executor to process
4. Executor takes the optimized query and executes it
5. Result obtained from the executed query is sent back to the Data Access Logic
